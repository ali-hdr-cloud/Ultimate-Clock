rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /blocks/{blockedUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      // Keep reads query-compatible: the app queries with
      // whereArrayContains("participants", request.auth.uid).
      // Do not add participant-count checks here, because Firestore rules are
      // not filters and those extra constraints can make the whole query fail.
      function member(data) {
        return signedIn() && request.auth.uid in data.participants;
      }

      function validParticipantList(data) {
        return data.participants is list
          && data.participants.size() >= 2
          && data.participants.size() <= 50
          && request.auth.uid in data.participants;
      }

      function validCreate(data) {
        return validParticipantList(data) && (
          ((!('type' in data) || data.type == 'direct') && data.participants.size() == 2)
          ||
          (('type' in data) && data.type == 'group'
            && data.participants.size() >= 3
            && data.groupName is string
            && data.groupName.size() >= 2
            && data.groupName.size() <= 60
            && data.admins is list
            && request.auth.uid in data.admins)
        );
      }

      allow read: if member(resource.data);
      allow create: if validCreate(request.resource.data);
      allow update: if member(resource.data)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage','lastSenderId','updatedAt','seenBy','participantInfo','type'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        function chatData() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function isMember() { return signedIn() && request.auth.uid in chatData().participants; }
        function isGroup() { return ('type' in chatData()) && chatData().type == 'group'; }
        function otherUid() { return chatData().participants[0] == request.auth.uid ? chatData().participants[1] : chatData().participants[0]; }
        function validKind(data) {
          return !('kind' in data) || data.kind in ['text','image','video','file','voice'];
        }
        function validBody(data) {
          return data.text is string
            && data.text.size() <= 4000
            && (
              (!('kind' in data) && data.text.size() > 0)
              || (('kind' in data) && data.kind == 'text' && data.text.size() > 0)
              || (('kind' in data) && data.kind != 'text' && data.mediaUrl is string && data.mediaUrl.size() > 0 && data.mediaUrl.size() <= 4096)
            );
        }
        function reactionChangeIsOwn() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map
            && (
              (!('reactions' in resource.data) && request.resource.data.reactions.keys().hasOnly([request.auth.uid]))
              ||
              (('reactions' in resource.data) && resource.data.reactions is map
                && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))
            );
        }

        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.senderId == request.auth.uid
          && validKind(request.resource.data)
          && validBody(request.resource.data)
          && (
            isGroup()
            || (
              !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(otherUid()))
              && !exists(/databases/$(database)/documents/users/$(otherUid())/blocks/$(request.auth.uid))
            )
          );
        allow update: if isMember() && reactionChangeIsOwn();
        allow delete: if false;
      }
    }
  }
}
