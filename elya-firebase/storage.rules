rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function chatMember(chatId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    match /chat-media/{chatId}/{uid}/{fileName=**} {
      allow read: if chatMember(chatId);
      allow create: if chatMember(chatId)
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024;
      allow update: if false;
      allow delete: if chatMember(chatId) && request.auth.uid == uid;
    }
  }
}
